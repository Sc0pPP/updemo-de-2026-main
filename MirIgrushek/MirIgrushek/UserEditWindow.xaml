<Window x:Class="MirIgrushek.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление пользователя — ООО «МирИгрушек»" Icon="pack://application:,,,/MirIgrushek;component/Resources/icon.ico"
        Height="430" Width="460" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Arial" Background="White">
    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="Фамилия:" Margin="0,4,0,2"/>
            <TextBox x:Name="txtSurname" Height="26" VerticalContentAlignment="Center"/>
            <TextBlock Text="Имя:" Margin="0,8,0,2"/>
            <TextBox x:Name="txtName" Height="26" VerticalContentAlignment="Center"/>
            <TextBlock Text="Отчество:" Margin="0,8,0,2"/>
            <TextBox x:Name="txtPatronymic" Height="26" VerticalContentAlignment="Center"/>
            <TextBlock Text="Логин:" Margin="0,8,0,2"/>
            <TextBox x:Name="txtLogin" Height="26" VerticalContentAlignment="Center"/>
            <TextBlock Text="Пароль:" Margin="0,8,0,2"/>
            <TextBox x:Name="txtPassword" Height="26" VerticalContentAlignment="Center"/>
            <TextBlock Text="Роль:" Margin="0,8,0,2"/>
            <ComboBox x:Name="cmbRole" Height="26" DisplayMemberPath="RoleName"
                      SelectedValuePath="IDRole"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Сохранить" Width="120" Height="32"
                        Background="#DEB887" Foreground="White" FontWeight="Bold"
                        Cursor="Hand" Click="BtnSave_Click"/>
                <Button Content="Отмена" Width="100" Height="32" Margin="8,0,0,0"
                        Background="#F5DEB3" Cursor="Hand"
                        IsCancel="True" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
