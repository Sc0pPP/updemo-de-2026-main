<Window x:Class="MirIgrushek.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы — ООО «МирИгрушек»" Icon="pack://application:,,,/MirIgrushek;component/Resources/icon.ico"
        Height="600" Width="1150" MinHeight="420" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Arial" Background="White"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F5DEB3">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Назад" Width="90" Height="30"
                        Background="White" Cursor="Hand" Click="BtnBack_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/MirIgrushek;component/Resources/icon.png" Height="40" Width="40" Stretch="Uniform"/>
                    <TextBlock Text="Заказы — ООО «МирИгрушек»" VerticalAlignment="Center"
                               FontSize="16" FontWeight="Bold" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="txtUser" VerticalAlignment="Center"
                           FontWeight="Bold" TextAlignment="Right" Margin="8,0"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,6">
            <Button x:Name="btnAdd" Content="Добавить заказ" Width="140" Height="30"
                    Background="#DEB887" Foreground="White" FontWeight="Bold"
                    Cursor="Hand" Visibility="Collapsed" Click="BtnAdd_Click"/>
            <Button x:Name="btnDelete" Content="Удалить заказ" Width="130" Height="30"
                    Margin="8,0,0,0" Background="White" Cursor="Hand"
                    Visibility="Collapsed" Click="BtnDelete_Click"/>
            <TextBlock x:Name="txtHint" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"
                       Text="Двойной щелчок по заказу открывает форму редактирования (только администратор)."/>
        </StackPanel>
        <ListView Grid.Row="2" x:Name="listOrders" Margin="8,0,8,8"
                  MouseDoubleClick="ListOrders_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="№" Width="50" DisplayMemberBinding="{Binding IDOrder}"/>
                    <GridViewColumn Header="Дата заказа" Width="110"
                                    DisplayMemberBinding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                    <GridViewColumn Header="Дата выдачи" Width="110"
                                    DisplayMemberBinding="{Binding OrderDeliveryDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                    <GridViewColumn Header="Пункт выдачи" Width="280" DisplayMemberBinding="{Binding Address}"/>
                    <GridViewColumn Header="Клиент" Width="200" DisplayMemberBinding="{Binding UserFullName}"/>
                    <GridViewColumn Header="Код получения" Width="100" DisplayMemberBinding="{Binding OrderCode}"/>
                    <GridViewColumn Header="Статус" Width="110" DisplayMemberBinding="{Binding StatusName}"/>
                    <GridViewColumn Header="Состав (ID, кол-во)" Width="180" DisplayMemberBinding="{Binding Composition}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
