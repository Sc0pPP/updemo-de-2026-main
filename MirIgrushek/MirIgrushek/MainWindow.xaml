<Window x:Class="MirIgrushek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Окно входа — ООО «МирИгрушек»" Icon="pack://application:,,,/MirIgrushek;component/Resources/icon.ico"
        Height="470" Width="430" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Arial" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F5DEB3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Image Source="pack://application:,,,/MirIgrushek;component/Resources/icon.png" Height="64" Width="64" Stretch="Uniform"/>
                <TextBlock Text="ООО «МирИгрушек»" VerticalAlignment="Center" FontSize="20"
                           FontWeight="Bold" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="30,20" VerticalAlignment="Center">
            <TextBlock Text="Авторизация" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <TextBlock Text="Логин:" Margin="0,4,0,2"/>
            <TextBox x:Name="txtLogin" Height="28" VerticalContentAlignment="Center"/>
            <TextBlock Text="Пароль:" Margin="0,10,0,2"/>
            <PasswordBox x:Name="txtPassword" Height="28" VerticalContentAlignment="Center"/>
            <Button x:Name="btnLogin" Content="Войти" Height="34" Margin="0,20,0,0"
                    Background="#DEB887" Foreground="White" FontWeight="Bold"
                    Cursor="Hand" Click="BtnLogin_Click"/>
            <Button x:Name="btnGuest" Content="Продолжить как гость" Height="30"
                    Margin="0,10,0,0" Background="#F5DEB3" Cursor="Hand"
                    Click="BtnGuest_Click"/>
            <!-- Капча-пазл: появляется после первой неудачной попытки входа -->
            <Border x:Name="captchaPanel" Visibility="Collapsed" Margin="0,14,0,0"
                    BorderBrush="#DEB887" BorderThickness="2" CornerRadius="6"
                    Background="#FFF8E7" Padding="10">
                <StackPanel>
                    <TextBlock Text="Контрольная проверка: соберите пазл — кликните по двум ячейкам, чтобы поменять их местами."
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid x:Name="puzzleGrid" Width="300" Height="300" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="btnPuzzleCheck" Content="Проверить" Width="110" Height="30"
                                Background="#DEB887" Foreground="White" FontWeight="Bold"
                                Cursor="Hand" Click="BtnPuzzleCheck_Click"/>
                        <Button x:Name="btnPuzzleRefresh" Content="Обновить" Width="110" Height="30"
                                Margin="8,0,0,0" Background="#F5DEB3" Cursor="Hand"
                                Click="BtnPuzzleRefresh_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="Учётные данные для входа берутся из базы данных."
                       TextWrapping="Wrap" Margin="0,16,0,0" Opacity="0.6"
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
