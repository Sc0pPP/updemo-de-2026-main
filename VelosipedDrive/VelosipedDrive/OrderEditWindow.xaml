<Window x:Class="VelosipedDrive.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление заказа — ООО «ВелосипедДрайв»" Icon="pack://application:,,,/VelosipedDrive;component/Resources/icon.ico"
        Height="600" Width="640" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Arial" Background="White">
    <Grid Margin="16">
        <StackPanel>
            <StackPanel x:Name="rowId" Orientation="Horizontal">
                <TextBlock Text="Номер заказа (ID):"/>
                <TextBlock x:Name="txtId" FontWeight="Bold" Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Состав заказа:" FontWeight="Bold" Margin="0,8,0,2"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="cmbProduct" Width="380" Height="26"
                          ToolTip="Товар со складской ценой со скидкой и остатком"/>
                <TextBox x:Name="txtCount" Width="60" Height="26" Text="1" Margin="8,0,0,0"
                         VerticalContentAlignment="Center" ToolTip="Количество"/>
                <Button Content="+ Добавить товар" Width="140" Height="26" Margin="8,0,0,0"
                        Background="#6A5ACD" Foreground="White" FontWeight="Bold"
                        Cursor="Hand" Click="BtnAddItem_Click"/>
            </StackPanel>
            <ListBox x:Name="listItems" Height="140" Margin="0,8,0,0" BorderBrush="#4B0082">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Display}" Width="440"/>
                            <Button Content="−" Width="24" Height="24" Margin="4,0"
                                    Tag="{Binding}" Click="BtnMinus_Click"/>
                            <TextBlock Text="{Binding Count}" Width="24"
                                       VerticalAlignment="Center" TextAlignment="Center"/>
                            <Button Content="+" Width="24" Height="24" Margin="4,0"
                                    Tag="{Binding}" Click="BtnPlus_Click"/>
                            <Button Content="Убрать" Width="70" Height="24" Margin="8,0,0,0"
                                    Tag="{Binding}" Click="BtnRemove_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Итого:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtTotal" FontWeight="Bold" Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Статус заказа:" Width="190" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbStatus" Width="240" Height="26"
                          DisplayMemberPath="StatusName" SelectedValuePath="IDStatus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Адрес пункта выдачи:" Width="190" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbPickupPoint" Width="330" Height="26"
                          DisplayMemberPath="Address" SelectedValuePath="IDPickupPoint"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Дата заказа:" Width="190" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpOrderDate" Width="160" Height="26"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Дата выдачи:" Width="190" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpDeliveryDate" Width="160" Height="26"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Код для получения:" Width="190" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtCode" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Сохранить" Width="120" Height="32"
                        Background="#6A5ACD" Foreground="White" FontWeight="Bold"
                        Cursor="Hand" Click="BtnSave_Click"/>
                <Button Content="Отмена" Width="100" Height="32" Margin="8,0,0,0"
                        Background="#4B0082" Foreground="White" Cursor="Hand"
                        IsCancel="True" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
