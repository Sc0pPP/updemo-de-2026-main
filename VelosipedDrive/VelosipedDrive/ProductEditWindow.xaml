<Window x:Class="VelosipedDrive.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление товара — ООО «ВелосипедДрайв»" Icon="pack://application:,,,/VelosipedDrive;component/Resources/icon.ico"
        Height="600" Width="560" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Arial" Background="White">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Vertical">
            <Border BorderBrush="Gray" BorderThickness="1" Width="150" Height="100">
                <Image x:Name="imgPhoto" Width="146" Height="96" Stretch="Uniform"/>
            </Border>
            <Button Content="Выбрать фото" Width="150" Height="28" Margin="0,6,0,0"
                    Background="#6A5ACD" Cursor="Hand" Click="BtnPickPhoto_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <StackPanel x:Name="rowId" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="ID товара:" Width="150" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtId" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Наименование:" Width="150" VerticalAlignment="Center"/>
                <TextBox x:Name="txtName" Width="200" Height="26" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Категория товара:" Width="150" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbCategory" Width="200" Height="26"
                          DisplayMemberPath="CategoryName" SelectedValuePath="IDCategory"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Производитель:" Width="150" VerticalAlignment="Center"/>
                <TextBox x:Name="txtManufacturer" Width="200" Height="26" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Поставщик:" Width="150" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbSupplier" Width="200" Height="26"
                          DisplayMemberPath="SupplierName" SelectedValuePath="IDSupplier"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Цена:" Width="150" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPrice" Width="200" Height="26" VerticalContentAlignment="Center"
                         ToolTip="Стоимость не может быть отрицательной, допускаются сотые части"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Единица измерения:" Width="150" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbUnit" Width="200" Height="26"
                          DisplayMemberPath="UnitName" SelectedValuePath="IDUnit"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Количество на складе:" Width="150" VerticalAlignment="Center"/>
                <TextBox x:Name="txtStock" Width="200" Height="26" VerticalContentAlignment="Center"
                         ToolTip="Количество не может быть отрицательным"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Действующая скидка, %:" Width="150" VerticalAlignment="Center"/>
                <TextBox x:Name="txtDiscount" Width="200" Height="26" VerticalContentAlignment="Center"
                         ToolTip="Целое число от 0 до 100"/>
            </StackPanel>
            <TextBlock Text="Описание товара:" Margin="0,8,0,2"/>
            <TextBox x:Name="txtDescription" Height="80" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Сохранить" Width="120" Height="32"
                        Background="#4B0082" Foreground="White" FontWeight="Bold"
                        Cursor="Hand" Click="BtnSave_Click"/>
                <Button Content="Отмена" Width="100" Height="32" Margin="8,0,0,0"
                        Background="#6A5ACD" Cursor="Hand"
                        IsCancel="True" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
